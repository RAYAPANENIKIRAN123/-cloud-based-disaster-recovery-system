<script>
function login(){
let u=document.getElementById("username").value;
let p=document.getElementById("password").value;
if(u && p) openApp();
else alert("Please enter username and password.");
}

function demoLogin(){openApp()}

function openApp(){
document.getElementById("login").style.display="none";
document.getElementById("app").style.display="block";
}

function logout(){
document.getElementById("app").style.display="none";
document.getElementById("login").style.display="flex";
}

function showPage(page,btn){
document.querySelectorAll(".page").forEach(p=>p.classList.remove("active"));
document.getElementById(page).classList.add("active");

document.querySelectorAll(".menu button").forEach(b=>b.classList.remove("active"));
if(btn) btn.classList.add("active");
}

function openModal(title,text){
document.getElementById("modalTitle").innerText=title;
document.getElementById("modalText").innerText=text;
document.getElementById("modalProgress").style.width="0%";
document.getElementById("modalStatus").innerText="0%";
document.getElementById("modal").style.display="flex";
}

function closeModal(){
document.getElementById("modal").style.display="none";
}

function runBackup(){
openModal("Backup in Progress","Creating secure cloud backup...");

let progress=0;
let timer=setInterval(()=>{
progress+=5;
document.getElementById("modalProgress").style.width=progress+"%";
document.getElementById("modalStatus").innerText=progress+"%";

if(progress>=100){
clearInterval(timer);
document.getElementById("modalText").innerText="Backup completed successfully!";
document.getElementById("modalStatus").innerText="✓ Completed";

let activity=document.getElementById("activity");
let li=document.createElement("li");
li.innerText="✅ New cloud backup completed successfully";
activity.prepend(li);

document.getElementById("pointCount").innerText="157";
}
},150);
}

function startRecovery(){
openModal("Disaster Recovery","Initializing recovery process...");

let progress=0;
let stages=[
"Detecting system failure...",
"Verifying cloud backup...",
"Restoring data...",
"Starting cloud services...",
"Validating system...",
"Recovery completed!"
];

let timer=setInterval(()=>{
progress+=5;
document.getElementById("modalProgress").style.width=progress+"%";
document.getElementById("modalStatus").innerText=progress+"%";

let index=Math.min(Math.floor(progress/20),5);
document.getElementById("modalText").innerText=stages[index];

if(progress>=100){
clearInterval(timer);
document.getElementById("modalText").innerText="✓ Disaster Recovery Completed Successfully";
document.getElementById("modalStatus").innerText="System Restored";
}
},150);
}

function simulateDisaster(){
showPage("alerts",document.querySelectorAll(".menu button")[5]);

let alertBox=document.createElement("div");
alertBox.className="alert";
alertBox.innerHTML=
"<div>🚨 <b>CRITICAL DISASTER DETECTED</b><br><small>Database-01 service failure detected. Recovery is recommended.</small></div><span class='badge red'>Critical</span>";

document.getElementById("alertsList").prepend(alertBox);

alert("⚠ DISASTER DETECTED!\nDatabase-01 has failed.\nStart disaster recovery immediately.");
}

function toggleMode(){
document.body.style.background=
document.body.style.background==="rgb(15, 23, 42)" ? "#f4f7fb" : "#0f172a";
document.body.style.color=
document.body.style.color==="white" ? "#172033" : "white";
}

function searchTable(value){
value=value.toLowerCase();

document.querySelectorAll("table tr").forEach((row,index)=>{
if(index===0)return;
row.style.display=row.innerText.toLowerCase().includes(value)?"":"none";
});
}
</script>

</body>
